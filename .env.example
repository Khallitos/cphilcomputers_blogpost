# Contact form — copy this file to .env.local and fill in the values.
# The form works without these (dev mode), but messages are only delivered
# once RESEND_API_KEY is set.

# Where contact-form messages should be delivered.
CONTACT_TO_EMAIL=carlphil9924@gmail.com

# API key from https://resend.com (for email delivery).
RESEND_API_KEY=
